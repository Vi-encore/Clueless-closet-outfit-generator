# Copy to .env and change what you need. Both settings have defaults, so an
# empty .env - or none at all - is fine for local work.

# Port the API listens on.
PORT=3000

# One of: development, production, test.
NODE_ENV=development

# Required, no default. Matches docker-compose.yml; `closet_test` is the database
# the tests use.
DATABASE_URL=postgresql://closet:closet@localhost:5432/closet

# The database the `test:db` suite writes to.
DATABASE_URL_TEST=postgresql://closet:closet@localhost:5432/closet_test

# Signs the access tokens. At least 32 characters; generate one with
# `node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"`.
JWT_SECRET=generate your own, at least 32 characters

# How often one caller may ask, per window, per address. The window is shared by
# both allowances; the second one covers sign-up, sign-in and refresh, where
# guessing pays off and the general allowance would be far too generous.
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# How many proxy hops to believe when working out who is calling. 0 means the
# socket's own address and nothing else — correct when the API is reached
# directly. Behind one reverse proxy set 1, behind a proxy and a CDN set 2.
# Too low and every caller looks like the proxy, so one of them exhausts the
# allowance for everybody. Too high and anyone can forge X-Forwarded-For and
# walk around the limit entirely.
TRUST_PROXY=0
