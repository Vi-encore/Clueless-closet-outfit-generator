# Committed, unlike every other .env here: it holds no secret, since anything
# prefixed VITE_ ends up in the bundle a browser downloads, and this one value is
# what lets a fresh clone run. A build for anywhere else gets its address from
# wherever it is built.
#
# The API directly, not through a Vite proxy. See "Development talks to the API
# across origins" in the add-web-shell design for why.
VITE_API_URL=http://localhost:3000
