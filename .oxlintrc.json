{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true
  },
  "rules": {
    "typescript/no-explicit-any": "off",
    "typescript/no-floating-promises": "error"
  },
  "ignorePatterns": ["**/dist/**", "**/coverage/**", "**/src/generated/**"],
  "overrides": [
    {
      "files": ["apps/web/**"],
      "plugins": ["react", "jsx-a11y"],
      "env": {
        "browser": true
      }
    }
  ]
}
