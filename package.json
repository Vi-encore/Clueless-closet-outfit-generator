{
  "name": "clueless-closet",
  "version": "0.0.0",
  "private": true,
  "description": "Digital wardrobe and outfit generator — pnpm workspace root",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @closet/core build && pnpm --filter @closet/api start:dev"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.9.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.9.1",
  "devDependencies": {
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10"
  }
}
